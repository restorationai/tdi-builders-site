---
// HubSpotFormSection — client-supplied HubSpot form at the bottom of the
// homepage (Robert, TDI 2026-10-02: "It's on the homepage at the very
// bottom"). Two-column layout modeled on the Sierra Renovations homepage:
// pitch + call button on the left, the form on the right. The embed markup is
// exactly what the client sent; the existing estimate form is untouched.
import { brand } from "~/lib/brand";
import { Phone, CheckCircle2 } from "@lucide/astro";
---

<section id="project-form" class="bg-white py-20 border-t border-dark/10">
  <div class="container-wide max-w-6xl mx-auto grid gap-12 lg:grid-cols-2 items-start">
    <div>
      <p class="text-sm font-bold uppercase tracking-widest text-primary-700 mb-3">Free Estimate &middot; No Obligation</p>
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4 tracking-tight">Tell Us About Your Project</h2>
      <p class="text-lg text-dark/70 mb-8">Share a few details and our team will follow up with clear next steps.</p>
      <a
        href={`tel:${brand.phoneRaw}`}
        class="inline-flex items-center justify-center gap-3 font-bold px-8 py-3 rounded-md transition-all text-lg shadow-lg bg-cta text-cta-fg hover:bg-cta-hover mb-8"
      >
        <Phone size={20} strokeWidth={2.5} />
        Call {brand.phone}
      </a>
      <ul class="space-y-3">
        {brand.trustBadges.map((b) => (
          <li class="flex items-center gap-3 text-dark/80 font-semibold">
            <CheckCircle2 size={20} class="text-primary-600 shrink-0" />
            {b}
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-xl border border-dark/10 bg-white shadow-lg p-6 md:p-8">
      <script is:inline src="https://js-na2.hsforms.net/forms/embed/48033708.js" defer></script>
      <div class="hs-form-frame" data-region="na2" data-form-id="f7271551-01cd-4136-8970-1bb8a4597408" data-portal-id="48033708"></div>
    </div>
  </div>
</section>
